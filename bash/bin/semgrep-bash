#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
rules_path="${script_dir}/../rules"

if ! command -v semgrep >/dev/null 2>&1; then
  echo "Error: 'semgrep' executable was not found. Install it: https://semgrep.dev/docs/getting-started/" >&2
  exit 1
fi

if [ ! -d "${rules_path}" ]; then
  echo "Error: bash rules directory not found at: ${rules_path}" >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  args=(".")
else
  args=("$@")
  has_positional=false
  for arg in "${args[@]}"; do
    case "${arg}" in
      -*) ;;
      *) has_positional=true ;;
    esac
  done
  if [ "${has_positional}" = false ]; then
    args+=(".")
  fi
fi

exec semgrep --error --config "${rules_path}" "${args[@]}"
