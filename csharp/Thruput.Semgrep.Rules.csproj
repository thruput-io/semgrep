<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Thruput.Semgrep.Rules</PackageId>
    <Version>0.1.1</Version>
    <Authors>Thruput</Authors>
    <Company>Thruput</Company>
    <Description>Curated Semgrep ruleset for .NET codebases with auto-bootstrapped CLI support, covering correctness, null safety, security, and performance.</Description>
    <PackageTags>thruput;semgrep;linter;csharp;dotnet;security;clean-code;quality</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thruput-io/semgrep</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thruput-io/semgrep</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Rules/content-only package, no compiled dll binaries required -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test fixture .cs files from project compilation -->
    <Compile Remove="rules\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <None Include="rules\**\*.cs" />

    <!-- Package README -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />

    <!-- Include all C# rules into package -->
    <None Include="rules\**\*.yaml" Pack="true" PackagePath="rules\csharp\" />

    <!-- Include MSBuild targets for consumers -->
    <None Include="build\Thruput.Semgrep.Rules.targets" Pack="true" PackagePath="build\Thruput.Semgrep.Rules.targets" />
  </ItemGroup>

</Project>
