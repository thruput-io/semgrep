<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Provide the path to the packaged C# Semgrep rules for downstream MSBuild projects -->
    <SemgrepCSharpRulesPath Condition="'$(SemgrepCSharpRulesPath)' == ''">$(MSBuildThisFileDirectory)../rules/csharp</SemgrepCSharpRulesPath>
  </PropertyGroup>

  <!-- Optional target to run semgrep during dotnet build if EnableSemgrepOnBuild is true -->
  <Target Name="SemgrepLint" AfterTargets="Build" Condition="'$(EnableSemgrepOnBuild)' == 'true'">
    <Message Importance="high" Text="Running Semgrep C# Linter rules from $(SemgrepCSharpRulesPath)..." />
    <Exec Command="semgrep --config &quot;$(SemgrepCSharpRulesPath)&quot; --error &quot;$(MSBuildProjectDirectory)&quot;" 
          ContinueOnError="false" />
  </Target>

</Project>
